#!/usr/bin/make -f

# db note: same "no CMake install() rules yet" situation as rts2-base
# (see base/debian/rules and base/STATUS.md's Debian-packaging section) -
# dh_auto_install is overridden to copy build output directly. db nests
# the base source tree via DB_BASE_DIR (defaults to ../base, see
# db/CMakeLists.txt) - the build host needs both source trees checked
# out side by side, same as for local development. We don't set
# BASE_GXCCD_SDK_DIR/BASE_FLI_SDK_DIR here: rts2-db doesn't ship or need
# any camera driver, and those CMake options just cleanly skip the
# corresponding base subdirectories when unset.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

BUILDDIR = obj-$(DEB_HOST_MULTIARCH)

%:
	dh $@ --buildsystem=cmake --builddirectory=$(BUILDDIR)

override_dh_auto_configure:
	dh_auto_configure --buildsystem=cmake --builddirectory=$(BUILDDIR) -- \
		-DCMAKE_INSTALL_PREFIX=/usr

# Binaries this package ships: rts2-executor and the four target-management
# CLI tools. rts2-testdb-create/rts2-testdb-destroy (db/sql/) are
# dev-only test tooling - deliberately not installed, see db/STATUS.md.
RTS2DB_BINARIES = \
	executor/rts2-executor \
	db/tools/rts2-newtarget \
	db/tools/rts2-target \
	db/tools/rts2-targetinfo \
	db/tools/rts2-targetlist

override_dh_auto_install:
	install -d debian/rts2-db/usr/bin
	for b in $(RTS2DB_BINARIES); do \
		install -m 0755 $(BUILDDIR)/$$b debian/rts2-db/usr/bin/; \
	done
	install -d debian/rts2-db/usr/share/rts2-db/sql/create
	install -d debian/rts2-db/usr/share/rts2-db/sql/update
	install -d debian/rts2-db/usr/share/rts2-db/sql/data
	install -m 0644 sql/create/*.sql debian/rts2-db/usr/share/rts2-db/sql/create/
	install -m 0644 sql/update/*.sql debian/rts2-db/usr/share/rts2-db/sql/update/
	install -m 0644 sql/data/*.sql debian/rts2-db/usr/share/rts2-db/sql/data/
	install -m 0644 sql/grant.sql debian/rts2-db/usr/share/rts2-db/sql/grant.sql
	install -m 0755 sql/rts2-builddb debian/rts2-db/usr/share/rts2-db/sql/rts2-builddb
	install -m 0755 sql/rts2-configdb debian/rts2-db/usr/share/rts2-db/sql/rts2-configdb

# No systemd unit of its own - rts2-executor runs via rts2-base's existing
# rts2-start/rts2@.service mechanism (postinst adds a line to
# /etc/rts2/services), same as every device. See db/STATUS.md for why
# a standalone unit didn't work (Type=simple + bare ExecStart bypasses the
# --server auto-injection and --run-as privilege-drop that mechanism
# already provides, and doesn't match how rts2-base's own units track a
# forking daemon).

# Same reasoning as rts2-base: no CMake test target exercises real
# hardware or a live database, and a from-scratch rebuild under ctest at
# package-build time would add nothing.
override_dh_auto_test:
