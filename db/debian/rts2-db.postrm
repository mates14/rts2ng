#!/bin/sh
# postrm for rts2-db.
#
# Deliberately does NOT drop the database, the Postgres role, or the
# system user, even on purge - a site's 'stars' database is irreplaceable
# observation data, not disposable package configuration. This is the
# opposite of db/sql/rts2-testdb-destroy (dev-only test tooling, which
# exists specifically to destroy things) - print manual-cleanup
# instructions instead of ever doing it automatically.

set -e

case "$1" in
    purge)
        # Package bookkeeping only (the executor-service-added stamp,
        # see postinst) - not observation data, safe to remove unlike
        # everything else this case handles.
        rm -rf /var/lib/rts2-db

        if getent passwd rts2 >/dev/null 2>&1; then
            echo "rts2-db: package removed, but the 'stars' database, the 'rts2'" >&2
            echo "Postgres role, and the 'rts2' system user were left in place -" >&2
            echo "this package never deletes observation data automatically." >&2
            echo "To remove them yourself:" >&2
            echo "  sudo -u postgres dropdb stars" >&2
            echo "  sudo -u postgres psql -c \"DROP ROLE rts2;\"" >&2
            echo "  sudo deluser rts2" >&2
        fi
    ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

exit 0
