# rts2-viewer exposure modes for FLORES, the fiber-fed prism spectrograph
# on the Perek 2 m (see viewer-scripting.md next to this file for how to
# write modes). Enable with
#   [viewer]
#   modes = /usr/share/rts2/viewer-modes/flores.modes
# in rts2.ini, or rts2-viewer --modes <file>.
#
# The night procedure these follow is the FLORES howto (Part A/B). The
# instrument box is the TOPTEC device (rtspy's toptec.py):
#   CAM_POS   stage position in raw steps - what the chip sees:
#             1050 object fibre 2 (the untilted one), 13290 ThAr comp on
#             both fibres, 14930 flat on both fibres
#   FIBCOMP   Quido relay 1, the ThAr comp lamp (1/0)
#   FIBFLAT   Quido relay 2, the flat lamp (1/0)
# (The spectrograph's own lamp pair, SPEC.SPCOMP/SPFLAT, is gone for
# good and never lit FLORES.)
#
# NEVER let the comp lamp shine on a single fibre (CAM_POS 12965 or
# 13615, the comp presets of TOPTEC's table): it overexposes the CCD and
# the residual takes half an hour or more to clear, cold longer. So every
# mode switches both lamps off and waits until they are off before the
# stage moves, waits until the stage has arrived and only then switches a
# lamp on and exposes. A mode stopped half-way leaves its lamp on - the
# next mode switches it off before moving anything.
#
# Every write is followed by "sleep 3" before its waitfor. TOPTEC (rtspy)
# reports a written value back at once, as if it were already done - a
# CAM_POS write returns when the move starts, a relay write before the
# relay switches - and only its next poll (once a second) replaces that
# with what the hardware says. A waitfor straight after the write sees
# the echo and passes at once: tested against the real toptec.py with
# simulated hardware, the comp lamp then came on and the frames were taken
# while the stage was still moving. Nor does the camera wait for the
# move by itself (TOPTEC's BOP_EXPOSURE did not hold the exposure back),
# so the waitfor on CAM_POS is what keeps the frames in place.
#
# A TOPTEC newer than 2026-10-13 (rtspy, not deployed yet) answers a
# CAM_POS or lamp write only once it is done and shows the real state, so
# there the sleeps are no longer needed - they are kept, harmless, for as
# long as an older TOPTEC may be running.
#
# The ThAr needs no warm-up: on just for the exposure, off right after.
#
# Not here, on purpose: SPEC.SPECFILT (must be 4 for FLORES, set by hand -
# every wheel move shifts the wavelength scale and starts a new comp
# session) and focus. Plain exposure and Dark touch nothing, so they work
# whatever the stage and lamps are set to by hand in the TOPTEC client.
#
# The usual times: Exposure 60 s, Calib time 1 s. Lambda calib is then the
# howto's full pair (60 s + 1 s), Spectrum + lambda a science frame with
# the 1 s check comp after it, and the flat 1 s.

[Plain exposure]
color = cyan
script = E $EXPTIME

[Spectrum + lambda]
color = green
script = TOPTEC.FIBCOMP=0 TOPTEC.FIBFLAT=0 TOPTEC.CAM_POS=1050 
  sleep 1 
  TOPTEC.waitfor FIBCOMP 0 0.5 TOPTEC.waitfor FIBFLAT 0 0.5 TOPTEC.waitfor CAM_POS 1050 3
  E $EXPTIME
  TOPTEC.FIBCOMP=1 TOPTEC.CAM_POS=13290
  sleep 1 
  TOPTEC.waitfor CAM_POS 13290 3 TOPTEC.waitfor FIBCOMP 1 0.5
  E $CALTIME
  TOPTEC.FIBCOMP=0 

[Spectral flat]
color = yellow
script = TOPTEC.FIBCOMP=0 TOPTEC.FIBFLAT=1
  TOPTEC.CAM_POS=14930 sleep 1 TOPTEC.waitfor CAM_POS 14930 3
  TOPTEC.waitfor FIBCOMP 0 0.5 TOPTEC.waitfor FIBFLAT 1 0.5
  E $CALTIME
  TOPTEC.FIBFLAT=0

[Lambda calib]
color = purple
script = TOPTEC.FIBCOMP=1 TOPTEC.FIBFLAT=0
  TOPTEC.CAM_POS=13290 sleep 1 TOPTEC.waitfor CAM_POS 13290 3
  TOPTEC.waitfor FIBCOMP 1 0.5 TOPTEC.waitfor FIBFLAT 0 0.5
  E $EXPTIME E $CALTIME
  TOPTEC.FIBCOMP=0

[Dark]
color = red
script = D $EXPTIME
