#!/bin/bash
#
# rts2-stop - stop the RTS2 daemons listed in
# @BASE_CONFDIR@/rts2/{centrald,devices,services}
#
# base note (2026-08-27): this used to be a second, independent copy of
# rts2-start's config parsing and kill logic, which is how the two drifted
# apart - rts2-stop never learned about per-daemon --lock-prefix, so it
# could not stop a daemon that used one. It is now a thin front end for
# rts2-start, which does the work in stop mode and is the single place any
# of this is implemented.

# prefer a sibling rts2-start, so this works from a build tree too
here=$(dirname "$(readlink -f "$0")")
if [ -x "$here/rts2-start" ]; then
	exec "$here/rts2-start" --stop "$@"
fi
exec @CMAKE_INSTALL_FULL_BINDIR@/rts2-start --stop "$@"
