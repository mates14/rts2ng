# systemd unit to start every device/service listed in
# @BASE_CONFDIR@/rts2/{centrald,devices,services}
#
# After=postgresql.service is ordering only (no Wants=): on a host with the
# database (executor, selector) RTS2 starts after it, and on a base-only
# host without PostgreSQL systemd ignores ordering against a unit that is
# not there. The classic unit had the same line.
[Unit]
Description=RTS2 (all configured devices/services)
Documentation=https://github.com/RTS2/rts2
After=postgresql.service

[Service]
Type=forking
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/rts2-start all
ExecStop=@CMAKE_INSTALL_FULL_BINDIR@/rts2-stop all

[Install]
WantedBy=multi-user.target
