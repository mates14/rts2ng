import argparse
import os
import subprocess
import sys

import astropy.units as u
from astropy.coordinates import SkyCoord

HOOK = os.path.join(os.path.dirname(os.path.abspath(__file__)),
	"target-offset-hook.py")


def resolve_radec(tokens):
	"""tokens is whatever's left on the command line after --polar/--dec-
	sign are stripped out. Two tokens that parse as coordinates (either
	decimal degrees or sexagesimal HMS/DMS) win; otherwise the tokens are
	joined back into a name and resolved via Simbad/Sesame (works for
	multi-word names too, e.g. "center Andromeda Galaxy").

	Plain decimal degrees MUST be tried before sexagesimal - SkyCoord's
	hourangle parser happily accepts a bare number like "10.6847" as
	10.6847 *hours* (i.e. silently multiplies it by 15) instead of
	raising, so trying it first would misinterpret every plain-degree
	input rather than falling through to the right parser."""
	if len(tokens) == 2:
		try:
			return float(tokens[0]), float(tokens[1])
		except ValueError:
			pass
		try:
			c = SkyCoord(tokens[0], tokens[1], unit=(u.hourangle, u.deg))
			return c.ra.deg, c.dec.deg
		except Exception:
			pass

	name = " ".join(tokens)
	if not name:
		print(f"center: don't know what to do with {tokens!r}", file=sys.stderr)
		sys.exit(1)
	print(f"center: resolving '{name}' via Simbad/Sesame...")
	try:
		c = SkyCoord.from_name(name)
	except Exception as e:
		print(f"center: could not resolve '{name}': {e}", file=sys.stderr)
		sys.exit(1)
	return c.ra.deg, c.dec.deg


def main():
	parser = argparse.ArgumentParser(
		description="Point target-offset-hook.py at a new target - name, "
			"coordinates, or the celestial pole.")
	parser.add_argument("--polar", action="store_true",
		help="target the celestial pole instead of a name/coordinates")
	parser.add_argument("--dec-sign", type=float, choices=(1.0, -1.0), default=None,
		help="with --polar: +1 north / -1 south (default: auto per image)")
	parser.add_argument("target", nargs="*",
		help="object name (e.g. M31), or RA Dec as two tokens "
			"(decimal degrees or sexagesimal HMS/DMS)")
	args = parser.parse_args()

	if args.polar:
		cmd = [HOOK, "--polar"]
		if args.dec_sign is not None:
			cmd += ["--dec-sign", str(args.dec_sign)]
		subprocess.run(cmd, check=True)
		print("center: now targeting the celestial pole")
		return

	if not args.target:
		parser.error("give an object name, RA Dec, or --polar")

	ra, dec = resolve_radec(args.target)
	subprocess.run([HOOK, "--radec", str(ra), str(dec)], check=True)
	print(f"center: now targeting RA={ra:.4f} Dec={dec:.4f}")


if __name__ == "__main__":
	main()
