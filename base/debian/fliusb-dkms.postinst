#!/bin/sh
# postinst for fliusb-dkms: register the module source with DKMS and build
# it for the running kernel (and, via AUTOINSTALL, every later one).
set -e

NAME=fliusb
VERSION=1.5

if [ "$1" = configure ]; then
	# prerm removed the previous build; the source under /usr/src may be
	# new even though the module version is not.
	dkms remove -m $NAME -v $VERSION --all >/dev/null 2>&1 || true
	dkms add -m $NAME -v $VERSION
	# A missing headers package for the running kernel should not leave
	# the package half-configured - DKMS builds it at the next kernel
	# install, or by hand with `dkms autoinstall`.
	if [ -d "/lib/modules/$(uname -r)/build" ]; then
		dkms build -m $NAME -v $VERSION && dkms install -m $NAME -v $VERSION || true
	else
		echo "fliusb-dkms: no headers for $(uname -r), module not built now" >&2
	fi
fi

#DEBHELPER#

exit 0
