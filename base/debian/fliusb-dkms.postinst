#!/bin/sh
# postinst for fliusb-dkms: register the module source with DKMS and build
# it for the running kernel (and, via AUTOINSTALL, every later one).
set -e

NAME=fliusb
VERSION=1.5

if [ "$1" = configure ]; then
	# prerm removed the previous build; the source under /usr/src may be
	# new even though the module version is not.
	dkms remove -m $NAME -v $VERSION --all >/dev/null 2>&1 || true
	dkms add -m $NAME -v $VERSION
	# A missing headers package for the running kernel should not leave
	# the package half-configured - DKMS builds it at the next kernel
	# install, or by hand with `dkms autoinstall`. The headers metapackage
	# in Depends only covers the newest kernel, not one still running
	# from before an upgrade.
	if [ -d "/lib/modules/$(uname -r)/build" ]; then
		# A camera plugged in before the module existed got no driver:
		# load it now rather than at the next replug or reboot.
		if dkms build -m $NAME -v $VERSION && dkms install -m $NAME -v $VERSION; then
			modprobe $NAME || true
		else
			echo "fliusb-dkms: module build for $(uname -r) FAILED, see above" >&2
		fi
	else
		echo "fliusb-dkms: no headers for $(uname -r), module not built;" \
			"install linux-headers-$(uname -r), then run dkms autoinstall" >&2
	fi
fi

#DEBHELPER#

exit 0
