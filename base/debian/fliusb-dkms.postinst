#!/bin/sh
# postinst for fliusb-dkms: register the module source with DKMS and build
# it for every installed kernel with headers (AUTOINSTALL then covers the
# kernels installed later).
set -e

NAME=fliusb
VERSION=1.5

if [ "$1" = configure ]; then
	# prerm removed the previous build; the source under /usr/src may be
	# new even though the module version is not.
	dkms remove -m $NAME -v $VERSION --all >/dev/null 2>&1 || true
	dkms add -m $NAME -v $VERSION
	# Every installed kernel, not just the running one: remove --all also
	# dropped the build for a kernel installed but not booted yet, and
	# AUTOINSTALL only builds for kernels installed after this. Building
	# only for uname -r left the 6.1.0-54 kernel at SBT and D50 without the
	# module, and D50's FLI wheel and focuser without a device after the
	# reboot (2026-10-21). A kernel without headers (a dangling build link)
	# is skipped; a failed build is reported, not fatal.
	running=$(uname -r)
	for build in /lib/modules/*/build; do
		[ -d "$build" ] || continue
		kernel=$(basename "$(dirname "$build")")
		if dkms build -m $NAME -v $VERSION -k "$kernel" && dkms install -m $NAME -v $VERSION -k "$kernel"; then
			# A camera plugged in before the module existed got no driver:
			# load it now rather than at the next replug or reboot.
			if [ "$kernel" = "$running" ]; then
				modprobe $NAME || true
			fi
		else
			echo "fliusb-dkms: module build for $kernel FAILED, see above" >&2
		fi
	done
	# The headers metapackage in Depends only covers the newest kernel, not
	# one still running from before an upgrade.
	if [ ! -d "/lib/modules/$running/build" ]; then
		echo "fliusb-dkms: no headers for $running, module not built for it;" \
			"install linux-headers-$running, then run dkms autoinstall" >&2
	fi
fi

#DEBHELPER#

exit 0
