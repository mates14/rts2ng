#!/usr/bin/make -f

# base note: no CMakeLists.txt in this tree has install() rules yet (see
# base/STATUS.md's Debian-packaging section) - adding them properly means
# touching ~30 individual driver CMakeLists.txt files, a separate future
# cleanup. For now dh_auto_install is overridden to copy build output
# directly, a standard technique for upstream trees without polished
# install() support.
#
# BASE_GXCCD_SDK_DIR points at the proprietary vendor SDK as it exists on
# this build host. It has no default here - it comes in from the
# environment (`?=` below only fills them in if unset),
# exported by buildme.sh from its per-machine site file
# (~/.config/rts2ng/site.cmake), so the plain-cmake build and this
# packaging build can never disagree on the path. Export them yourself
# before calling dpkg-buildpackage directly without buildme.sh.
#
# A given path turns its SDK option to ON, so a path that does not hold a
# usable SDK fails the configure instead of producing an empty
# rts2-drivers-gxccd package. No path - OFF, and the driver package comes
# out empty on purpose. Andor and paracl are always OFF: their drivers are
# not packaged (see RTS2_BASE_BINARIES below).
#
# FLI is always ON: libfli is bundled (external/fli), so rts2-drivers-fli
# is built on every host. BASE_FLI_SDK_DIR, if exported, overrides the
# bundled copy, same as in the plain-cmake build.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

BASE_GXCCD_SDK_DIR ?=
BASE_FLI_SDK_DIR ?=

BUILDDIR = obj-$(DEB_HOST_MULTIARCH)

%:
	dh $@ --buildsystem=cmake --builddirectory=$(BUILDDIR)

override_dh_auto_configure:
	dh_auto_configure --buildsystem=cmake --builddirectory=$(BUILDDIR) -- \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBASE_GXCCD_SDK_DIR=$(BASE_GXCCD_SDK_DIR) \
		-DBASE_GXCCD=$(if $(BASE_GXCCD_SDK_DIR),ON,OFF) \
		-DBASE_FLI_SDK_DIR=$(BASE_FLI_SDK_DIR) \
		-DBASE_FLI=ON \
		-DBASE_ANDOR=OFF \
		-DBASE_PARACL=OFF

# Binaries this package ships: centrald, rts2-mon, scriptexec, and every
# driver that builds without a bundled proprietary shared library (see
# debian/control). rts2-camd-andor (vendor SDK is .so-only) and
# rts2-teld-paramount (libmks3 not vendored, informal non-redistribution
# understanding on the source) are deliberately excluded - not even built,
# BASE_ANDOR/BASE_PARACL=OFF above.
RTS2_BASE_BINARIES = \
	centrald/rts2-centrald \
	centrald/rts2-state \
	monitor/rts2-mon \
	scriptexec/rts2-scriptexec \
	sendcmd/rts2-sendcmd \
	focusc/rts2-focusc \
	camd/dummy/rts2-camd-dummy \
	camd/v4l/rts2-camd-v4l \
	teld/dummy/rts2-teld-dummy \
	teld/d50/rts2-teld-d50 \
	teld/gemini/rts2-teld-gemini \
	teld/gemini-udp/rts2-teld-gemini-udp \
	teld/gemini-udp/rts2-teld-gemini-udp-imu \
	teld/lx200/rts2-teld-lx200 \
	focusd/dummy/rts2-focusd-dummy \
	focusd/tefo/rts2-focusd-tefo \
	focusd/aaf/rts2-focusd-aaf \
	focusd/optec/rts2-focusd-optec \
	focusd/nstep/rts2-focusd-nstep \
	filterd/dummy/rts2-filterd-dummy \
	sensord/system/rts2-sensor-system \
	sensord/nut/rts2-sensor-nut \
	sensord/cloud4/rts2-sensor-cloud4 \
	sensord/bart-rain/rts2-sensor-bart-rain \
	sensord/aws-mlab/rts2-sensor-aws-mlab \
	sensord/d50-wfunit/rts2-sensor-d50-wfunit \
	sensord/fram-weather/rts2-sensor-fram-weather \
	sensord/avelab/rts2-sensor-avelab \
	sensord/windrs/rts2-sensor-windrs \
	sensord/external/rts2-sensor-external \
	dome/d50/rts2-dome-d50 \
	dome/bart/rts2-dome-bart \
	dome/zelio/rts2-dome-zelio

# rts2-drivers-fli's binaries - always built (bundled libfli, see above).
RTS2_FLI_BINARIES = \
	camd/fli/rts2-camd-fli \
	focusd/fli/rts2-focusd-fli \
	filterd/fli/rts2-filterd-fli

# rts2-drivers-gxccd's binaries - only exist in $(BUILDDIR) if
# BASE_GXCCD_SDK_DIR was given (a wrong one fails the configure, see
# above); the install step below skips any that are missing rather than
# failing the whole build, so rts2-base stays buildable on a host without
# libgxccd (rts2-drivers-gxccd then simply comes out empty on that host).
RTS2_GXCCD_BINARIES = \
	camd/gxccd/rts2-camd-gxccd

override_dh_auto_install:
	install -d debian/rts2-base/usr/bin
	for b in $(RTS2_BASE_BINARIES); do \
		install -m 0755 $(BUILDDIR)/$$b debian/rts2-base/usr/bin/; \
	done
	install -m 0755 $(BUILDDIR)/packaging/rts2-start debian/rts2-base/usr/bin/
	install -m 0755 $(BUILDDIR)/packaging/rts2-stop debian/rts2-base/usr/bin/
	install -d debian/rts2-base/etc/rts2
	install -m 0644 $(BUILDDIR)/packaging/rts2.ini debian/rts2-base/etc/rts2/rts2.ini
	install -m 0644 $(BUILDDIR)/packaging/centrald debian/rts2-base/etc/rts2/centrald
	install -m 0644 $(BUILDDIR)/packaging/devices debian/rts2-base/etc/rts2/devices
	install -m 0644 $(BUILDDIR)/packaging/services debian/rts2-base/etc/rts2/services
	install -d debian/rts2-base/lib/systemd/system
	install -m 0644 $(BUILDDIR)/packaging/rts2.service debian/rts2-base/lib/systemd/system/rts2.service
	install -m 0644 "$(BUILDDIR)/packaging/rts2@.service" "debian/rts2-base/lib/systemd/system/rts2@.service"
	install -d debian/rts2-base/etc/rsyslog.d debian/rts2-base/etc/logrotate.d
	install -m 0644 packaging/rts2-rsyslog.conf debian/rts2-base/etc/rsyslog.d/49-rts2.conf
	install -m 0644 packaging/rts2-logrotate.conf debian/rts2-base/etc/logrotate.d/rts2-base
	install -d debian/rts2-drivers-fli/usr/bin
	for b in $(RTS2_FLI_BINARIES); do \
		install -m 0755 $(BUILDDIR)/$$b debian/rts2-drivers-fli/usr/bin/; \
	done
	# fliusb-dkms: the module source where DKMS expects it, built on the
	# target by fliusb-dkms.postinst (version 1.5 there and in dkms.conf)
	install -d debian/fliusb-dkms/usr/src/fliusb-1.5
	install -m 0644 external/fli/dkms.conf external/fli/fliusb/Makefile \
		external/fli/fliusb/fliusb.c external/fli/fliusb/fliusb.h \
		external/fli/fliusb/fliusb_ioctl.h external/fli/fliusb/README \
		debian/fliusb-dkms/usr/src/fliusb-1.5/
	install -d debian/rts2-drivers-gxccd/usr/bin
	for b in $(RTS2_GXCCD_BINARIES); do \
		if [ -f $(BUILDDIR)/$$b ]; then \
			install -m 0755 $(BUILDDIR)/$$b debian/rts2-drivers-gxccd/usr/bin/; \
		fi; \
	done

override_dh_installsystemd:
	dh_installsystemd -prts2-base --no-enable --no-start rts2.service
	dh_installsystemd -prts2-base --no-enable --no-start "rts2@.service"

# No CMake test target exercises real hardware, and kernel/tests requires
# a from-scratch full build - dh_auto_test would just rebuild everything
# again under ctest for no benefit at package-build time.
override_dh_auto_test:
