#!/usr/bin/make -f

# python note: pure Python, no compiled extensions and no CMake tree at
# all - the only one of rts2ng's packages that doesn't go through
# debhelper's cmake buildsystem. dh-python's pybuild driver runs setup.py
# directly - the exact same setup.py a plain `pip install .` would use,
# see setup.py's own docstring-adjacent note in README.md.
#
# The action scripts (focus.py, vaodscan.py) are deliberately NOT part of
# setup.py's packages - they're not meant to become PATH-accessible
# commands, they're meant to be found by rts2-base's script-path
# resolution (base/kernel/src/connfork.cpp) by bare name. Only the
# site-independent ones are packaged, via debian/rts2-python.install into
# /usr/share/rts2/scripts (dh_install keeps the executable bit). Scripts of
# one observatory (sites/) are not packaged at all: each site keeps its own
# in /etc/rts2/scripts, which script_path searches first. /etc/rts2/scripts
# is the site's, not this package's (it was a packaged symlink here until
# 2026-10-26; debian/rts2-python.postinst covers that upgrade).

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --with python3 --buildsystem=pybuild

# No test suite exists for this package (same reasoning as
# rts2-base/rts2-db/rts2-viewer's override_dh_auto_test - nothing to
# gain from running it as part of a package build).
override_dh_auto_test:
